generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum VideoSource {
  MANUAL
  IMPORTED
}
enum EvidenceLevel {
  META_ANALYSIS
  SYSTEMATIC_REVIEW
  RCT
  COHORT
  CASE_CONTROL
  EXPERT_OPINION
  OTHER
}

enum BodyMetricType {
  WEIGHT
  BODY_FAT
  CIRCUMFERENCE
  RESTING_HEART_RATE
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  nickname      String?        @unique
  avatarUrl     String?
  bio           String?
  height        Float?
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  comments      Comment[]
  likes         Like[]
  reports       Report[]
  articles      Article[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  notifications Notification[]
  workoutLogs   WorkoutLog[]
  plans         Plan[]
  bodyMetrics   BodyMetric[]
  achievements  UserAchievement[]
  favoriteLists FavoriteList[]
  conversation1 Conversation[] @relation("conversation1")
  conversation2 Conversation[] @relation("conversation2")
  messages      Message[]
  gyms          Gym[]
  gymCheckIns   GymCheckIn[]
  gymReviews    GymReview[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  type     String    // bodyPart | equipment | goal | topic
  videos   Video[]
  articles Article[]
}

model Video {
  id          String        @id @default(cuid())
  bvid        String        @unique
  title       String
  cover       String?
  duration    Int?
  description String?
  source      VideoSource   @default(MANUAL)
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  categories  Category[]
  references  Reference[]
  favorites   Favorite[]
  comments    Comment[]
  likes       Like[]
  reports     Report[]
}

model Article {
  id         String        @id @default(cuid())
  title      String
  content    String        // Markdown
  summary    String?
  coverUrl   String?
  status     PublishStatus @default(DRAFT)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  categories Category[]
  references Reference[]
  tags       Tag[]
  favorites  Favorite[]
  comments   Comment[]
  likes      Like[]
  reports    Report[]
}

model Reference {
  id            String        @id @default(cuid())
  title         String
  authors       String?
  year          Int?
  journal       String?
  doi           String?
  url           String?
  pmid          String?       @unique
  evidenceLevel EvidenceLevel?
  summaryZh     String?
  articles      Article[]
  videos        Video[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  articles Article[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // comment | reply | like | follow
  actorId    String?
  targetType String?  // video | article | comment | user
  targetId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  exercise  String
  sets      Int
  reps      Int
  weight    Float
  rpe       Float
  createdAt DateTime @default(now())
}

model Plan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        String   // 增肌 | 力量 | 减脂
  level       String   // 初级 | 中级 | 高级
  daysPerWeek Int
  contentJson String
  createdAt   DateTime @default(now())
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  listId    String?
  list      FavoriteList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  @@unique([userId, videoId])
  @@unique([userId, articleId])
}

model FavoriteList {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  favorites Favorite[]
  createdAt DateTime   @default(now())

  @@unique([userId, name])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, videoId])
  @@unique([userId, articleId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  commentId String?
  createdAt DateTime @default(now())
}

model BodyMetric {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BodyMetricType
  part      String?
  value     Float
  unit      String
  date      String
  note      String?
  createdAt DateTime       @default(now())

  @@index([userId, type, date])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String
  icon        String?
  unlocks     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant1   User      @relation("conversation1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2Id String
  participant2   User      @relation("conversation2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime  @default(now())

  @@unique([participant1Id, participant2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Gym {
  id            String         @id @default(cuid())
  name          String
  address       String
  city          String
  district      String?
  lat           Float
  lng           Float
  description   String?
  price         String?
  hours         String?
  phone         String?
  images        String[]
  status        GymStatus      @default(PENDING)
  submittedById String
  submittedBy   User           @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  equipment     GymEquipment[]
  checkIns      GymCheckIn[]
  reviews       GymReview[]

  @@index([city, district])
  @@index([status])
}

model GymEquipment {
  id       String @id @default(cuid())
  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name     String
  quantity Int    @default(1)
}

model GymCheckIn {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([gymId, userId, date])
}

model GymReview {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([gymId, userId])
}
