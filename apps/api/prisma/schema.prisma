generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum VideoSource {
  MANUAL
  IMPORTED
}
enum EvidenceLevel {
  META_ANALYSIS
  SYSTEMATIC_REVIEW
  RCT
  COHORT
  CASE_CONTROL
  EXPERT_OPINION
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  favorites    Favorite[]
  comments     Comment[]
  likes        Like[]
  reports      Report[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  type     String    // bodyPart | equipment | goal | topic
  videos   Video[]
  articles Article[]
}

model Video {
  id          String        @id @default(cuid())
  bvid        String        @unique
  title       String
  cover       String?
  duration    Int?
  description String?
  source      VideoSource   @default(MANUAL)
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  categories  Category[]
  references  Reference[]
  favorites   Favorite[]
  comments    Comment[]
  likes       Like[]
  reports     Report[]
}

model Article {
  id         String        @id @default(cuid())
  title      String
  content    String        // Markdown
  status     PublishStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  categories Category[]
  references Reference[]
  favorites  Favorite[]
  comments   Comment[]
  likes      Like[]
  reports    Report[]
}

model Reference {
  id            String        @id @default(cuid())
  title         String
  authors       String?
  year          Int?
  journal       String?
  doi           String?
  url           String?
  pmid          String?       @unique
  evidenceLevel EvidenceLevel?
  articles      Article[]
  videos        Video[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, videoId])
  @@unique([userId, articleId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, videoId])
  @@unique([userId, articleId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  commentId String?
  createdAt DateTime @default(now())
}
