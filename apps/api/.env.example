# PostgreSQL 连接串（把 <你的密码> 换成 postgres 用户的密码）
DATABASE_URL="postgresql://postgres:<你的密码>@localhost:5432/fitness_space_station"

# JWT 签名密钥（生产环境请换成随机长字符串）
JWT_SECRET="change-me-to-a-random-secret"

# 服务端口
PORT=3000

# DeepSeek API（文献翻译/内容审核/摘要标签；在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY="<你的 DeepSeek API key>"

# Meilisearch 搜索（启动命令见 README，或用 tools\meilisearch\meilisearch.exe --master-key <key> --http-addr 127.0.0.1:7700）
MEILI_URL="http://127.0.0.1:7700"
MEILI_MASTER_KEY="<Meilisearch master key>"