# ============ 生产环境变量（Docker Compose 使用） ============
# 复制为 .env.production 后填写：cp .env.production.example .env.production
# 注意：本文件不要提交真实密钥

# ---- PostgreSQL ----
POSTGRES_USER=fss
# 密码必须是「纯字母数字」（只用 a-z A-Z 0-9），否则会破坏 DATABASE_URL 解析
# 生成方式：openssl rand -hex 16
POSTGRES_PASSWORD=<换成 hex 随机串，只能用字母数字>
POSTGRES_DB=fitness_space_station

# ---- 应用密钥（务必换成随机长串） ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=<换成随机长串>

# ---- Meilisearch ----
MEILI_MASTER_KEY=<换成随机长串，至少 16 位>

# ---- DeepSeek（可选，不填则 LLM 相关功能降级） ----
DEEPSEEK_API_KEY=
