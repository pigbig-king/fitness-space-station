* text=auto

# 服务器脚本与容器配置必须保持 LF，否则在 Linux 上会因 \r 报错
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
.env.*.example text eol=lf
.dockerignore text eol=lf

# 图片等二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
